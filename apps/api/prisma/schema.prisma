generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum RecurrenceType {
  NONE
  WEEKLY
  MONTHLY
  YEARLY
}

enum PaymentMethod {
  CASH
  DEBIT
  CREDIT_CARD
  PIX
  BANK_TRANSFER
  OTHER
}

enum AlertType {
  BILL_DUE_TOMORROW
  BILL_OVERDUE
  CARD_CLOSING_TODAY
  GOAL_OVERDUE
  GOAL_COMPLETED
  INSUFFICIENT_BALANCE
  INCOME_EXPECTED
  INSTALLMENT_COMPLETED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categories     Category[]
  incomes        Income[]
  expenses       Expense[]
  recurringBills RecurringBill[]
  installments   Installment[]
  cards          Card[]
  goals          Goal[]
  alerts         Alert[]

  @@map("users")
}

model Category {
  id        String       @id @default(uuid())
  name      String
  type      CategoryType
  isDefault Boolean      @default(false)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  incomes        Income[]
  expenses       Expense[]
  recurringBills RecurringBill[]
  installments   Installment[]

  @@index([userId])
  @@map("categories")
}

model Income {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  value      Decimal        @db.Decimal(12, 2)
  categoryId String
  category   Category       @relation(fields: [categoryId], references: [id])
  date       DateTime
  recurrence RecurrenceType @default(NONE)
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([userId, date])
  @@map("incomes")
}

model Expense {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  value           Decimal        @db.Decimal(12, 2)
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])
  dueDate         DateTime
  paid            Boolean        @default(false)
  paymentMethod   PaymentMethod
  costCenter      String?
  notes           String?
  cardId          String?
  card            Card?          @relation(fields: [cardId], references: [id])
  recurringBillId String?
  recurringBill   RecurringBill? @relation(fields: [recurringBillId], references: [id], onDelete: SetNull)
  installmentId   String?
  installment     Installment?   @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  installmentSeq  Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId, dueDate])
  @@map("expenses")
}

model RecurringBill {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  value         Decimal       @db.Decimal(12, 2)
  categoryId    String
  category      Category      @relation(fields: [categoryId], references: [id])
  dueDay        Int
  paymentMethod PaymentMethod
  active        Boolean       @default(true)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  expenses Expense[]

  @@index([userId])
  @@map("recurring_bills")
}

model Installment {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product           String
  totalValue        Decimal  @db.Decimal(12, 2)
  installmentsCount Int
  installmentValue  Decimal  @db.Decimal(12, 2)
  startDate         DateTime
  cardId            String
  card              Card     @relation(fields: [cardId], references: [id])
  categoryId        String
  category          Category @relation(fields: [categoryId], references: [id])
  createdAt         DateTime @default(now())

  expenses Expense[]

  @@index([userId])
  @@map("installments")
}

model Card {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  limit      Decimal  @db.Decimal(12, 2)
  closingDay Int
  dueDay     Int
  createdAt  DateTime @default(now())

  expenses     Expense[]
  installments Installment[]

  @@index([userId])
  @@map("cards")
}

model Goal {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  targetValue  Decimal  @db.Decimal(12, 2)
  currentValue Decimal  @default(0) @db.Decimal(12, 2)
  targetDate   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@map("goals")
}

model Alert {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AlertType
  message   String
  read      Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([userId, read])
  @@map("alerts")
}
